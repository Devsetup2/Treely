{
  "name": "treely",
  "version": "1.0.0",
  "description": "Rahatlatıcı 3D ağaç ile link kısaltıcı + QR kod",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "node server/index.js",
    "build": "vite build",
