    "start": "node server/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "express": "^5.3.0",
    "qrcode": "^1.5.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "vite": "^8.3.4"
  }
}
